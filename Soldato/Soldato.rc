// English (U.S.) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_SOLDATO MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Connect...",                    IDM_CONNECT
        MENUITEM "&Disconnect",                    IDM_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                          IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Soldato...",              IDM_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Soldato"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_SOLDATO,IDC_MYICON,14,9,20,20
    LTEXT           "Soldato Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2024",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_CONNECT_DIALOG DIALOGEX 0, 0, 220, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to Network"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Multicast IP:",IDC_STATIC,10,10,60,12
    EDITTEXT        ID_MULTICAST_IP,10,25,100,18,ES_AUTOHSCROLL
    LTEXT           "Port:",IDC_STATIC,10,50,60,12
    EDITTEXT        ID_PORT,10,65,100,18,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Username:",IDC_STATIC,10,90,60,12
    EDITTEXT        ID_USERNAME,10,105,100,18,ES_AUTOHSCROLL
    PUSHBUTTON      "Connect",ID_CONNECT_BTN,130,25,60,20
    PUSHBUTTON      "Cancel",ID_CANCEL_BTN,130,55,60,20
END

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_SOLDATO           ICON                    "app.ico"
IDI_SMALL             ICON                    "app.ico"

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
    IDS_APP_TITLE            "Soldato"
END

