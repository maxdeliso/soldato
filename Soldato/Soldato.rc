#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_SOLDATO MENU
BEGIN
    POPUP "&Start"
    BEGIN
        MENUITEM "&Connect...",                    IDM_CONNECT
        MENUITEM "&Disconnect",                    IDM_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                          IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Soldato...",              IDM_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 260, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Soldato"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_SOLDATO,IDC_MYICON,14,9,20,20
    LTEXT           "",IDC_VERSION_TEXT,42,14,160,8,SS_NOPREFIX
    LTEXT           "GitHub:",IDC_GITHUB_LABEL,42,26,30,8
    PUSHBUTTON      "https://github.com/maxdeliso/soldato",ID_GITHUB_LINK,75,24,165,12,BS_FLAT
    CONTROL         "",IDC_GOL_CANVAS,"STATIC",SS_OWNERDRAW | WS_CHILD | WS_VISIBLE,10,40,240,70
    DEFPUSHBUTTON   "OK",IDOK,190,10,50,14,WS_GROUP
END

IDD_CONNECT_DIALOG DIALOGEX 0, 0, 200, 90
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to Network"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Multicast IP:",IDC_STATIC,10,10,60,12
    COMBOBOX        ID_MULTICAST_IP,10,25,100,60,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Port:",IDC_STATIC,10,48,60,12
    EDITTEXT        ID_PORT,10,63,100,18,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "Connect",ID_CONNECT_BTN,120,25,70,20
    PUSHBUTTON      "Cancel",ID_CANCEL_BTN,120,50,70,20
END

